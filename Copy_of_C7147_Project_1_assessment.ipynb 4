        "def find_mutations(sequence, reference):\n",
        "    \"\"\"Find each mismatch in a valid read, using 1_based positions.\"\"\"\n",
        "    mutations = []\n",
        "# pairs the lists to be numbered and share positions\n",
        "    for position, (reference_base, read_base) in enumerate(\n",
        "        # combines the lists so a number called is checked for position in both lists starting from 1 rather than pythons default of 0\n",
        "        zip(reference, sequence), start = 1\n",
        "    ):\n",
        "    # checks if positions are not the same and adds to list mutations\n",
        "        if read_base != reference_base:\n",
        "            mutations.append({\n",
        "                # tells position that the two lists differ\n",
        "                'position': position,\n",
        "                # the letter that is different reported\n",
        "                'reference_base': reference_base,\n",
        "                # the letter that is different reported\n",
        "                'read_base': read_base,\n",
        "            })\n",
        "\n",
        "    return mutations\n",
        " # Write your code here."
