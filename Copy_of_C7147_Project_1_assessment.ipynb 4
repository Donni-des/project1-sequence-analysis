        "# Write your code here.\n",
        "def _print_sample_summaries(summary):\n",
        "    \"\"\"Print sample and substitution tables, grouped by experimental group.\"\"\"\n",
        "    # organise samples by groups with this created empty dictionary\n",
        "    groups = {}\n",
        "\n",
        "    # loop through each sample and its info\n",
        "    for sample, details in summary.items():\n",
        "\n",
        "        # setdefault() creates empty list if a group is new\n",
        "        groups.setdefault(details['group'], []).append(sample)\n",
        "\n",
        "    # loop through each experimental group and its samples\n",
        "    for group, samples in groups.items():\n",
        "\n",
        "        # prints group names and table headings\n",
        "        print(f'\\nGROUP: {group}')\n",
        "        print(f\"{'Sample':<16} {'Valid':>7} {'Invalid':>8} \"\n",
        "              f\"{'Mismatch reads %':>18} {'Events':>8}  Top positions\")\n",
        "        print('-' * 90)\n",
        "\n",
        "        # print summary info for each sample\n",
        "        for sample in samples:\n",
        "            info = summary[sample]\n",
        "\n",
        "            # gets the percentage of valid reads containing mismatches\n",
        "            percentage = info['mismatch_percentage']\n",
        "\n",
        "            # use N/A when valid reads dont exist, otherwise show 2 decimal places\n",
        "            percentage_text = 'N/A' if percentage is None else f'{percentage:.2f}'\n",
        "\n",
        "            # top mutation position converts to coma-separated text\n",
        "            # if no poisitons exist, show 'None'\n",
        "            positions = ', '.join(str(p) for p in info['top_positions']) or 'None'\n",
        "\n",
        "            # print results in aligned columns\n",
        "            print(f\"{sample:<16} {info['valid_reads']:>7} \"\n",
        "                  f\"{info['invalid_reads']:>8} {percentage_text:>18} \"\n",
        "                  f\"{info['mismatch_events']:>8}. {positions}\")\n",
        "\n",
        "        # collects all sub types found within the group\n",
        "        # a set removes duplicates and ordered by sorted()\n",
        "        substitutions = sorted({\n",
        "            substitution\n",
        "            for sample in samples\n",
        "            for substitution in summary[sample]['substitution_counts']\n",
        "        })\n",
        "\n",
        "        # prints sub table heading\n",
        "        print('\\nSubstitution counts (events per 100 valid reads in brackets)')\n",
        "\n",
        "        # calculates column width so sample names fit correctly\n",
        "        col_width = max(19, *(len(sample) + 3 for sample in samples))\n",
        "        print(f\"{'Substitution':<16}\" + \"\".join(\n",
        "            f\"{sample:>{col_width}}\" for sample in samples\n",
        "        ))\n",
        "\n",
        "        # in no subs exist, print a message and skip to next group\n",
        "        if not substitutions:\n",
        "            print('No substitutions observed.')\n",
        "            continue\n",
        "\n",
        "        # loop through each sub type\n",
        "        for substitution in substitutions:\n",
        "            cells = []\n",
        "\n",
        "            # calculate the number and rate of subs per sample\n",
        "            for sample in samples:\n",
        "                info = summary[sample]\n",
        "\n",
        "                # get the sub count, using 0 if its absent\n",
        "                count = info['substitution_counts'].get(substitution, 0)\n",
        "\n",
        "                #avoid divinding by 0 when no valid reads exist\n",
        "                if info['valid_reads'] == 0:\n",
        "                    cell = f\"{count} (N/A)\"\n",
        "                else:\n",
        "                    # calculate substitution events per 100 valid reads\n",
        "                    rate = 100 * count / info['valid_reads']\n",
        "                    cell = f\"{count} ({rate:.2f}%)\"\n",
        "\n",
        "                # adds formatted result to the row\n",
        "                cells.append(f\"{cell:>{col_width}}\")\n",
        "\n",
        "            # print sub and its count for each sample\n",
        "            print(f\"{substitution:<16}\" + \"\".join(cells))\n",
        "\n",
        "def summarise_samples(analysed_reads):\n",
        "    \"\"\"Count valid/invalid reads, mismatches, substitutions and hot positions.\n",
        "\n",
        "    Percentages use valid reads only; none are calculated for samples with\n",
        "    no valid reads. The input dictionaries are never modified.\"\"\"\n",
        "\n",
        "    # creates empty dictionary to store results for each sample\n",
        "    summary = {}\n",
        "\n",
        "    # go through each analysed DNA read\n",
        "    for read in analysed_reads:\n",
        "        sample = read['sample']\n",
        "\n",
        "        # creates counters if this sample has not been recorded\n",
        "        if sample not in summary:\n",
        "            summary[sample] = {\n",
        "                'group': read['group'],\n",
        "                'valid_reads': 0,\n",
        "                'invalid_reads': 0,\n",
        "                'mismatch_reads': 0,\n",
        "                'mismatch_percentage': None,\n",
        "                'mismatch_events': 0,\n",
        "                'substitution_counts': {},\n",
        "                'position_counts': {},\n",
        "                'top_positions': [],\n",
        "            }\n",
        "\n",
        "        # gets summary dictionary for the current sample\n",
        "        current = summary[sample]\n",
        "\n",
        "        # checks if read is invalid\n",
        "        if read['status'] == 'invalid':\n",
        "            current['invalid_reads'] += 1\n",
        "\n",
        "            # skips remaining analysis for invalid read\n",
        "            continue\n",
        "\n",
        "\n",
        "        # if current read is valid, increases read counter for valid\n",
        "        current['valid_reads'] += 1\n",
        "\n",
        "        # if read contains mutations, it counts as a mismatch read\n",
        "        if read['mutations']:\n",
        "            current['mismatch_reads'] += 1\n",
        "\n",
        "        # goes through every mutation identified within the read\n",
        "        for mutation in read['mutations']:\n",
        "\n",
        "            # counts each individual mismatch event\n",
        "            current['mismatch_events'] += 1\n",
        "\n",
        "            # identify the sub, e.g. A>G\n",
        "            substitution = mutation['reference_base'] + '>' + mutation['read_base']\n",
        "\n",
        "            # gets the position where the mutation happened\n",
        "            position = mutation['position']\n",
        "\n",
        "            # increase the count for this sub type\n",
        "            current['substitution_counts'][substitution] = (\n",
        "                current['substitution_counts'].get(substitution, 0) + 1\n",
        "            )\n",
        "\n",
        "            # increase the number of mutations recorded at this point\n",
        "            current['position_counts'][position] = (\n",
        "                current['position_counts'].get(position, 0) + 1\n",
        "            )\n",
        "\n",
        "    # after processing all reads, calculate final sample statistics\n",
        "    for info in summary.values():\n",
        "\n",
        "        # only calculate percentages when valid reads are present\n",
        "        # this avoids division by 0\n",
        "        if info['valid_reads'] > 0:\n",
        "            info['mismatch_percentage'] = (\n",
        "                100 * info['mismatch_reads'] / info['valid_reads']\n",
        "            )\n",
        "\n",
        "        # sort mutation positions by frequency, highest first\n",
        "        # if frequencies are equal, sort by position number\n",
        "        # keep only the 3 most frequently mutated positions\n",
        "        info['top_positions'] = sorted(\n",
        "            info['position_counts'],\n",
        "            key=lambda position: (-info['position_counts'][position], position),\n",
        "        )[:3]\n",
        "\n",
        "\n",
        "    # print summary tables if at least one sample was analysed\n",
        "    if summary:\n",
        "        _print_sample_summaries(summary)\n",
        "\n",
        "    # return the complete summary dictionary\n",
        "    return summary\n"
