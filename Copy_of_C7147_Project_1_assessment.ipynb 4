        "def analyse_reads(reads, reference):\n",
        "    \"\"\"Return annotated copies of all reads, retaining invalid reads in order.\"\"\"\n",
        "    analysed = []\n",
        "\n",
        "    for read in reads:\n",
        "        checked = validate_read(read['sequence'], reference)\n",
        "        is_valid = checked['valid']\n",
        "\n",
        "        analysed.append({\n",
        "            'read_id': read['read_id'],\n",
        "            'sample': read['sample'],\n",
        "            'group': read['group'],\n",
        "            'sequence': checked['sequence'],\n",
        "            'status': 'valid' if is_valid else 'invalid',\n",
        "            'errors': checked['errors'],\n",
        "            'mutations': (\n",
        "            find_mutations(checked['sequence'], reference)\n",
        "            if is_valid else []\n",
        "            ),\n",
        "        })\n",
        "\n",
        "    return analysed\n",
        "\n",
