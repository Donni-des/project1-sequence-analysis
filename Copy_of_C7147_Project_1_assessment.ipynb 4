        "#@title 📊 calculate_statistics function\n",
        "\n",
        "from scipy import stats\n",
        "import math\n",
        "import warnings\n",
        "\n",
        "\n",
        "def calculate_statistics(control_percentages, treated_percentages):\n",
        "    \"\"\"Compare independent biological samples using a two-sided Welch's t-test.\"\"\"\n",
        "    unavailable = {\"statistic\": None, \"p_value\": None}\n",
        "\n",
        "    # Require at least two samples per group and finite numerical values.\n",
        "    if len(control_percentages) < 2 or len(treated_percentages) < 2:\n",
        "        return unavailable\n",
        "\n",
        "    values = list(control_percentages) + list(treated_percentages)\n",
        "    if any(value is None or not math.isfinite(value) for value in values):\n",
        "        return unavailable\n",
        "\n",
        "    # No within-group variation: the t-test cannot estimate uncertainty.\n",
        "    if (\n",
        "        len(set(control_percentages)) == 1\n",
        "        and len(set(treated_percentages)) == 1\n",
        "    ):\n",
        "        return unavailable\n",
        "\n",
        "    with warnings.catch_warnings():\n",
        "        warnings.simplefilter(\"ignore\", RuntimeWarning)\n",
        "        result = stats.ttest_ind(\n",
        "            treated_percentages,\n",
        "            control_percentages,\n",
        "            equal_var=False,\n",
        "            alternative=\"two-sided\"\n",
        "        )\n",
        "\n",
        "    if not (\n",
        "        math.isfinite(result.statistic)\n",
        "        and math.isfinite(result.pvalue)\n",
        "    ):\n",
        "        return unavailable\n",
        "\n",
        "    return {\n",
        "        \"statistic\": float(result.statistic),\n",
        "        \"p_value\": float(result.pvalue)\n",
        "    }"
