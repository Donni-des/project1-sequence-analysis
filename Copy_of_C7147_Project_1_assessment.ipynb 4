        "def validate_read(sequence, reference):\n",
        "    \"\"\"Uppercase a read and report length and invalid_base problems.\n",
        "\n",
        "    Return a dictionary with sequence, valid and ordered error codes.\"\"\"\n",
        "\n",
        "    normalised = sequence.upper()\n",
        "    errors = []\n",
        "\n",
        "    if len(normalised) != len(reference):\n",
        "        errors.append('wrong_length')\n",
        "    #'any' checkes for invalid characters in the base and the 'for' checks each base.\n",
        "    if any(base not in 'ACGT' for base in normalised):\n",
        "        errors.append('invalid_characters')\n",
        "\n",
        "    return {\n",
        "        # stores the data in these\n",
        "        'sequence': normalised,\n",
        "        # valid comes back as true if no errors are detected, otherwise comes as false.\n",
        "        'valid': len(errors) == 0,\n",
        "        'errors': errors,\n",
        "    }\n",
        "\n",
